# Local development only — copy to .env and fill in real values for deploy.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to a postgres:// URL to use PostgreSQL; leave empty for local SQLite.
DATABASE_URL=
# Max CSV upload size in bytes (default 5 MB).
CSV_UPLOAD_MAX_BYTES=5242880
# InsForge OAuth (Google/GitHub sign-in) — leave unset to keep
# password-only login. INSFORGE_BASE_URL and VITE_INSFORGE_URL are the
# same project URL; VITE_INSFORGE_ANON_KEY is the project's public
# anon key (browser-safe). Flip ENABLED to true only once the project
# exists and the keys are set.
INSFORGE_AUTH_ENABLED=false
INSFORGE_BASE_URL=
VITE_INSFORGE_URL=
VITE_INSFORGE_ANON_KEY=
