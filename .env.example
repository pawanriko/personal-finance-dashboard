# Local development only — copy to .env and fill in real values for deploy.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to a postgres:// URL to use PostgreSQL; leave empty for local SQLite.
DATABASE_URL=
# Max CSV upload size in bytes (default 5 MB).
CSV_UPLOAD_MAX_BYTES=5242880
# Google/GitHub sign-in (django-allauth) — leave unset to keep
# password-only login. A provider button appears only when both of
# its values are set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Password-reset mail (production). Local dev prints reset links to
# the server console instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Personal Finance <no-reply@localhost>
